# ── PATH ──────────────────────────────────────────────────────────────────────

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PATH="$HOME/.npm-global/bin:$PATH"
export PATH="$HOME/.go/bin:$PATH"
export PATH="$HOME/.bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.bun/bin:$PATH"

# Docker Desktop also links these into /usr/local/bin, so this is only a
# fallback for when it is set not to. Append rather than prepend: the directory
# ships a kubectl, and a real one installed later should win over it.
export PATH="$PATH:$HOME/.docker/bin"

# ── Locale ────────────────────────────────────────────────────────────────────

export LC_ALL="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"

# ── General ───────────────────────────────────────────────────────────────────

export PROJECTS="$HOME/Source"
export EDITOR="nvim"
export VISUAL="nvim"

# ── Go ────────────────────────────────────────────────────────────────────────

export GOPATH="$HOME/.go"

# ── Rust ──────────────────────────────────────────────────────────────────────

if [ -f "$HOME/.cargo/env" ]; then
	source "$HOME/.cargo/env"
fi

# ── Node ──────────────────────────────────────────────────────────────────────

# pnpm keeps one content-addressed store and hard-links packages from it into
# each `node_modules`, so many worktrees of one repository cost a single copy.
# The store lives under this directory and must stay on the same filesystem as
# the checkouts, or pnpm copies instead of links.
export PNPM_HOME="$HOME/.local/share/pnpm"

# ── Bazel ─────────────────────────────────────────────────────────────────────

# Bazel keys its output base on the workspace path, so every worktree gets its
# own `bazel-out` and rebuilds from scratch. The disk cache in ~/.bazelrc is
# what they share. This variable points the copilot-agent-runtime wrapper, which
# generates its own cache setting, at that same directory.
export COPILOT_BAZEL_DISK_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/bazel-disk"

# ── Bun ───────────────────────────────────────────────────────────────────────

export BUN_INSTALL="$HOME/.bun"

# ── GPG ───────────────────────────────────────────────────────────────────────

export GPG_TTY="$(tty)"

if command -v git >/dev/null 2>&1; then
	KEYID="$(git config --global --get user.signingkey 2>/dev/null)"
	[ -n "$KEYID" ] && export KEYID || unset KEYID
fi

# ── Less ──────────────────────────────────────────────────────────────────────

export LESS_TERMCAP_mb=$'\E[01;31m'
export LESS_TERMCAP_md=$'\E[01;31m'
export LESS_TERMCAP_me=$'\E[0m'
export LESS_TERMCAP_se=$'\E[0m'
export LESS_TERMCAP_so=$'\E[01;44;32m'
export LESS_TERMCAP_ue=$'\E[0m'
export LESS_TERMCAP_us=$'\E[01;33m'

# ── Terminfo ──────────────────────────────────────────────────────────────────

export TERMINFO_DIRS="${TERMINFO_DIRS:+$TERMINFO_DIRS:}$HOME/.local/share/terminfo"

# ── macOS ─────────────────────────────────────────────────────────────────────

if [[ "$OSTYPE" == darwin* ]]; then
	export LSCOLORS="exfxcxdxbxegedabagacad"
	export CLICOLOR="1"
fi

# ── Local overrides ───────────────────────────────────────────────────────────

if [ -f "$HOME/.zprofile.local" ]; then
	source "$HOME/.zprofile.local"
fi

# ── AI Agents ─────────────────────────────────────────────────────────────────

alias claude='ANTHROPIC_AUTH_TOKEN="$(gh auth token)" ANTHROPIC_BASE_URL=https://api.githubcopilot.com claude '
alias codex='GITHUB_TOKEN="$(gh auth token)" codex '

# vim:ft=sh
