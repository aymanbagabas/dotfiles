# Pre local overrides
if [ -f "$HOME/.zshrc.pre.local" ]; then
	source "$HOME/.zshrc.pre.local"
fi

# zinit installation
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
if [ ! -d "$ZINIT_HOME" ]; then
	mkdir -p "$(dirname "$ZINIT_HOME")"
	git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi
source "$ZINIT_HOME/zinit.zsh"
autoload -Uz _zinit
((${+_comps})) && _comps[zinit]=_zinit

# ── Prompt ────────────────────────────────────────────────────────────────────

zinit ice lucid wait'!'
zinit light sindresorhus/pure

# ── Oh-My-Zsh libs ────────────────────────────────────────────────────────────

zinit snippet OMZ::lib/key-bindings.zsh
zinit snippet OMZ::lib/completion.zsh
zinit snippet OMZ::lib/theme-and-appearance.zsh

# ── Oh-My-Zsh plugins ─────────────────────────────────────────────────────────

zinit snippet OMZ::plugins/git/git.plugin.zsh
zinit snippet OMZ::plugins/aws/aws.plugin.zsh

# ── Plugins ───────────────────────────────────────────────────────────────────

zinit ice lucid wait blockf
zinit light zsh-users/zsh-completions

zinit ice lucid wait
zinit light zsh-users/zsh-syntax-highlighting

zinit ice lucid wait
zinit light softmoth/zsh-vim-mode

zinit ice lucid wait
zinit light tinted-theming/tinted-shell

# ── Completions ───────────────────────────────────────────────────────────────

# Homebrew's completions live under its prefix, which varies by platform and
# architecture (/opt/homebrew, /usr/local, /home/linuxbrew/.linuxbrew, or a
# custom one) -- that is what `brew --prefix` was for. Use HOMEBREW_PREFIX when
# `brew shellenv` has run, else take it from brew's own path; $commands is a
# hash lookup, so neither costs a subshell. On Linux and Intel macOS the brew in
# $PREFIX/bin is a symlink into $PREFIX/Homebrew, but zsh records the
# unresolved path, so :h:h still yields the prefix. Only Homebrew's own zsh has
# this directory compiled into fpath and the login shell here is /bin/zsh, so it
# has to be added explicitly.
brew_site_functions=()
(($+commands[brew])) &&
	brew_site_functions=(${HOMEBREW_PREFIX:-${commands[brew]:h:h}}/share/zsh/site-functions(N))

# Homebrew goes last so zsh's native _git wins. Homebrew's _git is a thin
# wrapper around git's *bash* completion and needs the git-completion.bash that
# sits beside it in the keg; if that sibling is ever missing (a stale _git left
# behind by an unlinked keg, say) the wrapper still shadows the native one and
# every git completion dies with "command not found: __git_aliased_command".
# The native _git is also the richer of the two. Generated completions are
# written to the user directory once (e.g. `tool completion zsh >.../_tool`)
# instead of on every startup, and win over both.
fpath=(
	"${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions"
	$fpath
	$brew_site_functions
)
unset brew_site_functions

autoload -Uz compinit bashcompinit
compinit
bashcompinit

# ── Tool integrations ─────────────────────────────────────────────────────────

# fzf
if command -v fzf >/dev/null 2>&1; then
	source <(fzf --zsh)
	export FZF_DEFAULT_COMMAND="rg --files --hidden --no-ignore-vcs --glob '!.git/*'"
fi

# zoxide (replaces cd)
if command -v zoxide >/dev/null 2>&1; then
	eval "$(zoxide init zsh --no-cmd)"
	function z() { __zoxide_z "$@"; }
	alias cd="z"
fi

# direnv
if command -v direnv >/dev/null 2>&1; then
	eval "$(direnv hook zsh)"
fi

# fnm (Node.js version manager)
if command -v fnm >/dev/null 2>&1; then
	eval "$(fnm env --use-on-cd --shell zsh)"
fi

# eza (replaces ls)
if command -v eza >/dev/null 2>&1; then
	alias ls="eza"
	alias ll="eza -l"
	alias la="eza -la"
	alias lt="eza --tree"
fi

# ── Aliases ───────────────────────────────────────────────────────────────────

(($+commands[hub])) && alias git="hub"
alias vi="nvim"
alias vim="nvim"
(($+commands[copilot])) && alias cop="copilot --yolo"

# ── Environment ───────────────────────────────────────────────────────────────

export BASE16_THEME="onedark"
export BASE24_THEME="one-dark"

export KEYTIMEOUT=1

# zsh-vi-mode settings
export MODE_INDICATOR=""
export MODE_CURSOR_VIINS="blinking bar"
export MODE_CURSOR_REPLACE="$MODE_CURSOR_VIINS"
export MODE_CURSOR_VICMD="block"
export MODE_CURSOR_SEARCH="steady underline"
export MODE_CURSOR_VISUAL="$MODE_CURSOR_VICMD steady bar"
export MODE_CURSOR_VLINE="$MODE_CURSOR_VISUAL"

# pure prompt symbols
export PURE_PROMPT_SYMBOL="›"
export PURE_PROMPT_VICMD_SYMBOL="‹"

# less
export PAGER="less"
export LESS="-R --mouse --wheel-lines=3"

# ── History ───────────────────────────────────────────────────────────────────

HISTSIZE=10000
SAVEHIST=10000
HISTFILE="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/history"
[[ -d ${HISTFILE:h} ]] || mkdir -p ${HISTFILE:h}

# ── Options ───────────────────────────────────────────────────────────────────

# Allow ^ in git without glob matching
setopt NO_NOMATCH

# Reclaim Ctrl-S and Ctrl-Q
stty stop undef start undef -ixon

# Display fortune
if command -v fortune >/dev/null 2>&1; then
	echo "" && fortune -s && echo ""
fi

# ── Local overrides ───────────────────────────────────────────────────────────

for file in "$HOME/.zshrc.post.local" "$HOME/.zshrc.local"; do
	if [ -f "$file" ]; then
		source "$file"
	fi
done
